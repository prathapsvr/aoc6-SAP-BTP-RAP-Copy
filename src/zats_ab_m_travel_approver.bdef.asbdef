projection;
strict ( 2 );
use collaborative draft;

define behavior for ZATS_AB_M_TRAVEL_APPROVER alias Travel
{
  //use create;
  use update;
  field (readonly) CustomerId, AgencyId, TotalPrice, BeginDate, EndDate, Description;
  //use delete;

  use action acceptTravel;
  use action rejectTravel;
  //use action validateCustomer;

  use action Prepare;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Share;

  use association _Booking ; //{ create; with draft; }
}

define behavior for ZATS_AB_M_BOOKING_APPROVER alias Booking
{
  //use update;
  //use delete;

  use association _Travel;
}